# Deny by default so Docker receives only files used by the build stages.
**

!Dockerfile
!docker-entrypoint.sh
!package.json
!package-lock.json
!vite.config.ts
!tailwind.config.ts
!postcss.config.cjs
!tsconfig.json
!server.js

!frontend/
!frontend/**
!src/
!src/**
!tools/
!tools/mpkg/
!tools/mpkg/**

# Development and generated files inside otherwise included directories.
**/node_modules/
frontend/dist/
src/**/*.test.js
tools/mpkg/test_*.py
**/__pycache__/
**/*.pyc
**/*.log
**/*.tmp
